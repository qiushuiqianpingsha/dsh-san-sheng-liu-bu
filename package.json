{
  "name": "dsh-san-sheng-liu-bu",
  "displayName": "三省六部制流程优化插件",
  "version": "0.1.0",
  "description": "三省六部制流程优化插件：按任务难度自动切换推理档位与工具集。中书省定策（判定难度）、门下省审议（不确定时先问）、尚书省执行（六部工具按需启用）——简单任务轻装快跑，复杂任务全量推理。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "reasoning-effort",
    "latency",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiushuiqianpingsha/dsh-san-sheng-liu-bu.git"
  },
  "homepage": "https://github.com/qiushuiqianpingsha/dsh-san-sheng-liu-bu#readme",
  "bugs": {
    "url": "https://github.com/qiushuiqianpingsha/dsh-san-sheng-liu-bu/issues"
  }
}
